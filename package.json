{
  "name": "pitwall",
  "productName": "Pitwall",
  "version": "1.5.0",
  "description": "F1 25 career mode tracker: session results, standings, head-to-head, goals and AI media sessions.",
  "main": "main.js",
  "author": "Pitwall",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:android": "powershell -NoProfile -ExecutionPolicy Bypass -File android/build.ps1",
    "dist:win": "npm run build:android && electron-builder --win portable zip --x64",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "flag-icons": "^7.2.3"
  },
  "build": {
    "appId": "app.pitwall.f1career",
    "productName": "Pitwall",
    "files": [
      "main.js",
      "preload.js",
      "companion.js",
      "src/**/*",
      "build/icon.png",
      "build/Pitwall.apk"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Pitwall-${version}-portable.exe"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.sports"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Game"
    }
  }
}
